# ============================================================
# 人工上传的文件 —— 一律不入库
# 线上统一存在 /mnt/data/dragdrag/download（本仓库目录之外）。
# 下面这些是「万一有人把文件复制进仓库目录」的兜底。
# ============================================================
/download/
/uploads/
*.apk
*.iso
*.exe
*.zip
*.7z
*.rar
*.mp4
*.mov
*.pptx
*.xlsx
*.xls
*.docx
*.pdf
*.webp

# ============================================================
# 运行期数据 —— 含人工上传文件的名字，也不入库
# ============================================================
/sections_data.json
/clipboard_data.json
/.admin_password
/.env

# 备份 / 迁移残留
*.bak*
*.orig
*.tgz
*.tar.zst
*.patch

# ============================================================
# Python / 编辑器 / 探针临时产物
# ============================================================
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
/tmp/
*.png
